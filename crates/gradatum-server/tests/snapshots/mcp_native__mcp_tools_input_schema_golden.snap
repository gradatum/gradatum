    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request body for `vault_downgrade` — downgrades a note.\n\nSerialized via `bincode::serde::encode_to_vec` for the queue payload.\n\nPOST `/api/v1/vault_downgrade`. Idempotent: downgrading an already-downgraded\nnote returns 200 with the current status.",
    "properties": {
      "note_id": {
        "description": "ULID identifier of the note to downgrade.",
