    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_diff` — raw line-by-line diff between two versions.\n\n`a` and `b` are Unix ms timestamps (obtained from `vault_history`)\nor the literal string `\"current\"` for the current version.\nReturns a list of lines prefixed with ` ` (common), `-` (removed), `+` (added).",
    "properties": {
      "a": {
        "description": "Version A: Unix ms timestamp or `\"current\"`.",
        "type": "string"
      },
      "b": {
        "description": "Version B: Unix ms timestamp or `\"current\"`.",
        "type": "string"
      },
      "note_id": {
        "description": "Note ULID.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "note_id",
      "a",
      "b"
    ],
    "title": "VaultDiffRequest",
    "type": "object"
  },
