---
source: crates/gradatum-server/tests/mcp_native.rs
expression: schema_map
---
{
  "code_scope": {
    "$defs": {
      "CodeSelectorDto": {
        "additionalProperties": false,
        "description": "Selector for a `code_scope` request — explicit discriminant.\n\n`kind` ∈ {`query`, `path`, `symbol`}:\n- `query`: FTS5 full-text search (BM25) over the symbol corpus.\n- `path`: all symbols in a file or directory (prefix match on `source_path`).\n- `symbol`: symbols whose `qualified_name` contains `value` (substring match).",
        "properties": {
          "kind": {
            "description": "Selector type: `query` | `path` | `symbol`. Any other value → 400.",
            "type": "string"
          },
          "value": {
            "description": "Criterion value (keywords, path, or symbol name).",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `POST /api/v1/code_scope` (frozen wire contract).\n\n## Additive `include_body` fields (fully backward-compatible)\n\n- `include_body` (default `false`): if `true`, each entry receives a `body` field\n  containing the exact source span of the symbol. `false` = strictly unchanged\n  behavior, byte-for-byte identical JSON.\n- `body_budget_tokens` (default 4000, clamped to \\[1, 32000\\]): body budget independent\n  of `budget_tokens` (orthogonal). Cuts at whole-body boundaries; never truncates\n  mid-body. Entries without a body (stale or span absent): `body=null` omitted from\n  JSON (`skip_serializing_if`).\n\n## Additive `include_callers` field (fully backward-compatible, v0.6.3)\n\n- `include_callers` (default `false`): if `true`, each entry receives a `callers` field\n  listing the qualified names of symbols that declare this symbol in their outgoing `deps`\n  (i.e., reverse-dependency lookup). `false` = strictly unchanged behavior.\n- Results are limited by the same `budget_tokens` cap. The `callers` list is bounded\n  to [`MAX_CALLERS_PER_ENTRY`] entries to prevent payload explosion on widely-used symbols.\n- No lexical scoring: callers are returned in `qualified_name` ASC order (deterministic).\n\n## Mandatory two-pass pattern\n\n**Pass 1**: `include_body=false` (default) → rank the N relevant symbols by signature.\n**Pass 2**: `include_body=true` on the selected symbols only, with a targeted `selector`.\nUsing `include_body=true` on a broad query negates the token savings.",
    "properties": {
      "body_budget_tokens": {
        "description": "Token budget reserved for bodies (default [`DEFAULT_BODY_BUDGET_TOKENS`], clamped to \\[1, 32000\\]).\n\nIndependent of `budget_tokens`. Cuts at whole-body boundaries.\nIgnored if `include_body=false`.",
        "format": "uint",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "budget_tokens": {
        "description": "Response token budget (default [`DEFAULT_BUDGET_TOKENS`], clamped server-side).\nEntries are cut to K whole entries such that Σ tokens ≤ budget.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "include_body": {
        "default": false,
        "description": "If `true`, each entry receives `body` = exact source span of the symbol (tree-sitter).\n\nDefault `false` — strictly unchanged behavior.\nSee the two-pass pattern in the struct-level documentation.",
        "type": "boolean"
      },
      "include_callers": {
        "default": false,
        "description": "If `true`, each entry receives a `callers` field listing qualified names of symbols\nthat declare this symbol in their outgoing dependencies (reverse-dependency lookup).\n\nDefault `false` — strictly unchanged behavior (callers field absent from JSON).\nSee module documentation for the `include_callers` field semantics.",
        "type": "boolean"
      },
      "selector": {
        "$ref": "#/$defs/CodeSelectorDto",
        "description": "Search criterion (discriminant `kind` + `value`)."
      },
      "vault": {
        "description": "Target logical vault — MUST start with `code-` (e.g. `code-gradatum`).\nAny other vault (`main`, arbitrary vault_id) → 400 (security invariant).",
        "type": "string"
      }
    },
    "required": [
      "vault",
      "selector"
    ],
    "title": "CodeScopeRequest",
    "type": "object"
  },
  "vault_authors": {
    "properties": {},
    "type": "object"
  },
  "vault_classify": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_classify` — synchronous heuristic re-classification of an existing note.\n\nThe **LIVE queue path** (`SqliteQueueStore`) serializes this struct via `serde_json`.\nThe bincode serialization (`bincode::serde::encode_to_vec`) is used only by the\nlegacy `dispatch.rs` dispatcher and does not apply to the active job pipeline.",
    "properties": {
      "note_id": {
        "description": "ULID identifier of the note to re-classify.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Target tenant (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "note_id"
    ],
    "title": "VaultClassifyRequest",
    "type": "object"
  },
  "vault_context": {
    "$defs": {
      "ContextMode": {
        "description": "Assembly mode for the context produced by `vault_context`.\n\n- `Assembled` (default): the pipeline produces a pre-formatted LLM Markdown block.\n- `Raw`: returns raw hits without narrative assembly.\n- `Compact`: folded view — the most relevant notes stay inline, the rest are\n  folded into dereferenceable stubs. Requires a `session_id`.",
        "oneOf": [
          {
            "const": "assembled",
            "description": "Assembles hits into a ready-to-use LLM context block (default).",
            "type": "string"
          },
          {
            "const": "raw",
            "description": "Returns raw hits without narrative assembly.",
            "type": "string"
          },
          {
            "const": "compact",
            "description": "Folded view: the most relevant notes stay inline; the rest are folded into\ndereferenceable stubs. Replaces the context block on the client side (one cache reset).\nRequires a `session_id`.",
            "type": "string"
          }
        ]
      },
      "ScoringWeights": {
        "description": "Optional scoring weights for context-hit ranking.\n\nAll fields are optional — only the provided weights override pipeline defaults.\nAbsent fields leave the pipeline's internal values unchanged.",
        "properties": {
          "pagerank": {
            "description": "PageRank weight in the composite ranking score.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "recency": {
            "description": "Recency weight in the composite ranking score.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "trust": {
            "description": "Trust weight in the composite ranking score.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_context` — legacy vault v1.6.2 `VaultContextArgs` parity.",
    "properties": {
      "budget_tokens": {
        "description": "Token budget for context assembly (v0.7.0+).\n\nTakes precedence over `max_tokens` when both are present.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "inject_skills": {
        "default": false,
        "description": "Inject available skills into the context (default: `false`).",
        "type": "boolean"
      },
      "max_tokens": {
        "description": "Maximum number of context tokens (legacy — see `budget_tokens` for v0.7.0+).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "mode": {
        "$ref": "#/$defs/ContextMode",
        "default": "assembled",
        "description": "Context assembly mode (default: `Assembled`)."
      },
      "query": {
        "description": "Query for which to build the LLM context.",
        "type": "string"
      },
      "reference_mode": {
        "default": false,
        "description": "Enable reference mode: candidates that do not fit the inline budget are returned\nas dereferenceable stubs in the response's `references` field.\n\n`false` (default): `references` is always empty (backward-compatible behaviour).\n`true`: the inline/stub split is exposed in the response.\n\n**Additive field**: existing clients that omit it receive `false`\ndespite `deny_unknown_fields` (absent field → default value, no error).",
        "type": "boolean"
      },
      "scoring": {
        "anyOf": [
          {
            "$ref": "#/$defs/ScoringWeights"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional scoring weights for hit ranking."
      },
      "section": {
        "description": "Section filter (optional).",
        "type": [
          "string",
          "null"
        ]
      },
      "session_id": {
        "default": null,
        "description": "Session identifier for incremental context filtering.\n\nExpected format: ULID Crockford base32, 26 ASCII alphanumeric characters —\naligned with the `POST /api/v1/session-log/trace` handler validation.\n\n`None` (default): no session filter — all matching notes are candidates.\n`Some(id)`: notes already sent inline in this session are demoted to stubs\n(frozen snippet from `session_trace`); new inline notes are marked via\n`mark_sent` for subsequent turns (no re-promotion).\n\n**Additive field**: existing clients that omit it receive `None`.",
        "type": [
          "string",
          "null"
        ]
      },
      "skill_query": {
        "description": "Skill selection query (active when `inject_skills = true`).",
        "type": [
          "string",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "VaultContextRequest",
    "type": "object"
  },
  "vault_diff": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_diff` — raw line-by-line diff between two versions.\n\n`a` and `b` are Unix ms timestamps (obtained from `vault_history`)\nor the literal string `\"current\"` for the current version.\nReturns a list of lines prefixed with ` ` (common), `-` (removed), `+` (added).",
    "properties": {
      "a": {
        "description": "Version A: Unix ms timestamp or `\"current\"`.",
        "type": "string"
      },
      "b": {
        "description": "Version B: Unix ms timestamp or `\"current\"`.",
        "type": "string"
      },
      "note_id": {
        "description": "Note ULID.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "note_id",
      "a",
      "b"
    ],
    "title": "VaultDiffRequest",
    "type": "object"
  },
  "vault_downgrade": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request body for `vault_downgrade` — downgrades a note.\n\nThe **LIVE queue path** (`SqliteQueueStore`) serializes this struct via `serde_json`.\nThe bincode serialization (`bincode::serde::encode_to_vec`) is used only by the\nlegacy `dispatch.rs` dispatcher and does not apply to the active job pipeline.\n\nPOST `/api/v1/vault_downgrade`. Idempotent: downgrading an already-downgraded\nnote returns 200 with the current status.",
    "properties": {
      "note_id": {
        "description": "ULID identifier of the note to downgrade.",
        "type": "string"
      },
      "reason": {
        "description": "Reason for the downgrade (e.g. `\"obsolete\"`, `\"duplicate\"`, `\"revised\"`).\nMaximum 500 characters.",
        "type": "string"
      },
      "replaced_by": {
        "default": null,
        "description": "Replacement note (ULID, optional).",
        "type": [
          "string",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Target tenant (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "note_id",
      "reason"
    ],
    "title": "VaultDowngradeRequest",
    "type": "object"
  },
  "vault_forget": {
    "$defs": {
      "ForgetScopeDto": {
        "description": "Forget resolution scope — HTTP wire representation.\n\nL0 DTO: same structure as `ForgetScope` (gradatum-core) but without a dependency\non the domain crate (intentional decoupling).\n\nThe 3 variants are identified by the `type` field:\n- `\"topic\"`: FTS search.\n- `\"locus\"`: locus prefix.\n- `\"agent\"`: all notes from an agent.",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Resolution by FTS search over an optional vault.",
            "properties": {
              "limit": {
                "description": "Result cap (default 50, max 200).",
                "format": "uint",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "query": {
                "description": "FTS query (e.g. `\"secrets api-key\"`).",
                "type": "string"
              },
              "type": {
                "const": "topic",
                "type": "string"
              },
              "vault": {
                "description": "Target vault (optional — `None` = `\"main\"`).",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "query"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Resolution by locus prefix.",
            "properties": {
              "locus": {
                "description": "locus prefix (e.g. `\"inbox/old/\"`).",
                "type": "string"
              },
              "type": {
                "const": "locus",
                "type": "string"
              },
              "vault": {
                "description": "Target vault.",
                "type": "string"
              }
            },
            "required": [
              "type",
              "vault",
              "locus"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Resolution by agent — all notes from an `agent_id`.",
            "properties": {
              "agent_id": {
                "description": "Agent identifier (the `author_id` column).",
                "type": "string"
              },
              "type": {
                "const": "agent",
                "type": "string"
              },
              "vaults": {
                "default": [],
                "description": "List of target vaults (`[]` → `[\"main\"]`).",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "type",
              "agent_id"
            ],
            "type": "object"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_forget` — semantic forgetting of notes.\n\n# Dry-run required (default `true`)\n\nA forget without a prior preview is not possible in real mode:\n`dry_run = false` requires `confirm_ulids` to exactly match the ULIDs\nfrom a previous preview. Any discrepancy → **400 Bad Request**.\n\n# Recommended workflow\n\n1. `POST /vault_forget { scope, dry_run: true }` → `ForgetPreview { ulids, count, excluded }`\n2. Verify the preview (exact list of notes that will be forgotten).\n3. `POST /vault_forget { scope, dry_run: false, confirm_ulids: <ulids from preview> }`\n   → `ForgetJobResponse { job_id, status: \"queued\", poll_url, preview }` (202 Accepted —\n   mutations applied asynchronously by the worker)",
    "properties": {
      "confirm_ulids": {
        "description": "Confirmation ULIDs (required when `dry_run = false`).\n\nMust exactly match the ULIDs returned by the preview.\nAny discrepancy (addition, omission, different order) → **400 Bad Request**.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "dry_run": {
        "default": true,
        "description": "Dry-run (simulation without mutation) — default `true`.\n\nIn dry-run mode, no note is modified. The response contains the exact list\nof ULIDs that would be forgotten, plus exclusions (protected sections).",
        "type": "boolean"
      },
      "forgotten_by": {
        "description": "Actor triggering the forget (recorded as `forgotten_by`).\n\nOptional — `None` if not provided.",
        "type": [
          "string",
          "null"
        ]
      },
      "scope": {
        "$ref": "#/$defs/ForgetScopeDto",
        "description": "Resolution scope — determines the target notes."
      },
      "tenant_id": {
        "default": "main",
        "description": "Target tenant (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "scope"
    ],
    "title": "VaultForgetRequest",
    "type": "object"
  },
  "vault_graph": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_graph` — legacy vault v1.6.2 `VaultGraphArgs` parity.",
    "properties": {
      "depth": {
        "description": "Traversal depth (default 2, max 5).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "include_backlinks": {
        "description": "Include incoming links (`backlinks`).",
        "type": [
          "boolean",
          "null"
        ]
      },
      "root": {
        "description": "Starting note (path).",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "root"
    ],
    "title": "VaultGraphRequest",
    "type": "object"
  },
  "vault_history": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_history` — lists the copy-on-write snapshots of a note.\n\nReturns the Unix millisecond timestamps of snapshots stored in\n`.history/<note_id>/` for the note identified by `note_id`.",
    "properties": {
      "note_id": {
        "description": "Note ULID (e.g. `\"01JTEXAMPLE\"`).",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "note_id"
    ],
    "title": "VaultHistoryRequest",
    "type": "object"
  },
  "vault_history_get": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_history_get` — reads a specific historical snapshot.\n\nReturns the note content at the time of snapshot `ts_ms`.\n`ts_ms` must be a timestamp obtained from `vault_history`.",
    "properties": {
      "note_id": {
        "description": "Note ULID.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      },
      "ts_ms": {
        "description": "Unix ms timestamp of the snapshot (obtained from `vault_history`).",
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "note_id",
      "ts_ms"
    ],
    "title": "VaultHistoryGetRequest",
    "type": "object"
  },
  "vault_lessons_recall": {
    "$defs": {
      "RankMode": {
        "description": "Ranking mode for [`LessonsRecallRequest`].\n\nControls the final ordering of BM25 results after `recall_lessons`.\nWhen absent or `Relevance`, the legacy BM25 order is preserved (rétro-compat).\n\n# Wire encoding\n`\"relevance\"` or `\"recency-boosted\"` (kebab-case, serde `rename_all`).\n\n# Comportement par défaut\n`None` / absent → BM25 order inchangé (hook LIVE `lesson-recall.sh` en dépend).",
        "oneOf": [
          {
            "const": "relevance",
            "description": "Legacy BM25 order — default when the field is absent.\n\nA `rank=relevance` request is a no-op: it produces the same result as omitting\nthe field entirely. This preserves the rétro-compat invariant bit-for-bit.",
            "type": "string"
          },
          {
            "const": "recency-boosted",
            "description": "Multiply each BM25 rank-proxy score by `recency_factor(anchor_ms, now_ms)`,\nthen re-sort descending. Fresh lessons surface first.\n\n`recency_factor` uses λ = 0.01 (half-life ≈ 69 days, same as vault search).",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request for lesson recall.\n\nUsed to generate the `inputSchema` for the `vault_lessons_recall` MCP tool.\nOn the HTTP server side, these fields are received as query params (`?class=&limit=`).",
    "properties": {
      "class": {
        "description": "Controlled vocabulary class (one of [`LESSON_CLASSES`]):\n`deploy`, `release`, `migration`, `crates-io`, `anti-leak`, `api-external`,\n`archi`, `git-hygiene`, `ci-cd`, `auth-secrets`, `data-integrity`,\n`process-discipline`. Any other value is rejected (400).",
        "type": "string"
      },
      "limit": {
        "description": "Maximum number of lessons (server default 5, clamped to `[1, 20]`).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "query": {
        "description": "Requête textuelle pour la recherche sémantique (opt-in, `semantic = true`).\n\nSi absent quand `semantic = true`, la classe (`class`) est utilisée comme requête\npar défaut. Ignoré si `semantic = false` / absent.",
        "type": [
          "string",
          "null"
        ]
      },
      "rank": {
        "anyOf": [
          {
            "$ref": "#/$defs/RankMode"
          },
          {
            "type": "null"
          }
        ],
        "description": "Optional ranking mode.\n\n- absent / `\"relevance\"` → BM25 order (legacy behaviour, hook LIVE en dépend).\n- `\"recency-boosted\"` → rank-proxy × `recency_factor`, then sort descending.\n\nThe field is optional and `deny_unknown_fields` is already set on this struct,\nso the addition is rétro-compat: existing callers that omit the field continue\nto receive BM25-ordered results without any change."
      },
      "semantic": {
        "description": "Opt-in semantic (embedding) recall mode.\n\n- absent / `false` → chemin BM25 `recall_lessons` INCHANGÉ (rétro-compat absolue).\n  Les callers LIVE (hook `lesson-recall.sh`, agents, MCP) qui n'envoient pas ce champ\n  continuent à recevoir les résultats BM25 sans modification.\n- `true` → retrieval hybride RRF (`retrieve_candidates`) + hydratation ULID +\n  filtres `codified` / `class` en Rust. Si embed KO → fallback silencieux BM25.",
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "class"
    ],
    "title": "LessonsRecallRequest",
    "type": "object"
  },
  "vault_links": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_links` — thin alias over `vault_graph` with `depth=1`.",
    "properties": {
      "include_backlinks": {
        "description": "Include incoming links (`backlinks`).",
        "type": [
          "boolean",
          "null"
        ]
      },
      "path": {
        "description": "Target note for which to list links.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "title": "VaultLinksRequest",
    "type": "object"
  },
  "vault_list": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_list` — legacy vault v1.6.2 `VaultListArgs` parity.",
    "properties": {
      "cursor": {
        "description": "Pagination cursor (opaque token).",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Maximum number of entries (default 100, max 1000).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "pattern": {
        "description": "Optional glob filter pattern (e.g. `\"decisions/*\"`).",
        "type": [
          "string",
          "null"
        ]
      },
      "section": {
        "description": "Section to list (optional — if absent, lists all sections).",
        "type": [
          "string",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "title": "VaultListRequest",
    "type": "object"
  },
  "vault_proactive_recall": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request to pull the proactive memory surface or trigger contextual recall.\n\nWhen `context` is absent, the server returns the pre-computed proactive surface\n(`mode = \"proactive\"`). When `context` is present, the server runs an on-demand\ncontextual RRF retrieval (`mode = \"contextual\"`).\n\n# Wire notes\n`#[serde(deny_unknown_fields)]` rejects unrecognised fields — forward-compat\ndiscipline: consumers must stay within the declared contract.",
    "properties": {
      "context": {
        "description": "Optional context text for contextual recall.\n\nWhen present, the server computes an on-demand RRF retrieval using this text\nas the query and returns `mode = \"contextual\"`. When absent, the server returns\nthe pre-computed proactive surface (`mode = \"proactive\"`).",
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "description": "Maximum number of items to return (server default 10, clamped to `[1, 20]`).\n\nAbsent or `null`: server-default applies.",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "sections": {
        "description": "Optional section filter — restricts surfaced notes to this set of sections.\n\nAbsent or `null`: no section restriction (all sections surfaced).",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "title": "ProactiveRecallRequest",
    "type": "object"
  },
  "vault_proactive_recall_feedback": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request to submit feedback on a proactive recall session.\n\n`recall_id` must match a `recall_id` previously returned by the recall endpoint.\n`accepted_ulids` should be a subset of the ULIDs present in that response.\n\n# Wire notes\n`#[serde(deny_unknown_fields)]` enforces contract discipline (same as request).",
    "properties": {
      "accepted_ulids": {
        "description": "ULIDs of notes accepted (acted on) by the user.\n\nMust be a subset of the ULIDs present in the corresponding\n[`ProactiveRecallResponse::items`]. An empty vec is valid (no note accepted).",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "recall_id": {
        "description": "Recall session identifier returned by the recall endpoint.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "recall_id",
      "accepted_ulids"
    ],
    "title": "ProactiveRecallFeedbackRequest",
    "type": "object"
  },
  "vault_read": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_read` — legacy vault v1.6.2 `VaultReadArgs` parity.",
    "properties": {
      "path": {
        "description": "Path of the note to read (e.g. `\"decisions/my-note\"`).",
        "type": "string"
      },
      "section": {
        "description": "Target section (optional — if absent, reads from the vault root).",
        "type": [
          "string",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "title": "VaultReadRequest",
    "type": "object"
  },
  "vault_restore": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_restore` — restores a note from a snapshot.\n\nWrites snapshot `ts_ms` as the new current version.\nTriggers a copy-on-write (the previous current version is saved to `.history/`).\nReturns the SHA-256 hex hash of the restored version.",
    "properties": {
      "note_id": {
        "description": "ULID of the note to restore.",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      },
      "ts_ms": {
        "description": "Unix ms timestamp of the snapshot to restore.",
        "format": "int64",
        "type": "integer"
      }
    },
    "required": [
      "note_id",
      "ts_ms"
    ],
    "title": "VaultRestoreRequest",
    "type": "object"
  },
  "vault_search": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_search`.\n\n## Optional fields (backward-compatible)\n\n- `locus`: filter by physical path prefix (e.g. `\"council/\"` restricts to notes\n  whose `locus` starts with `council/`). Applied to both FTS and semantic paths.\n  The prefix is escaped against LIKE injection (metacharacters `%`, `_`, `\\`).\n- `vault_id`: cross-vault read — allows querying a vault other than `tenant_id`.\n  Writes remain unchanged (single-tenant). Validation: non-empty, max 128 chars.",
    "properties": {
      "from_ms": {
        "default": null,
        "description": "Earliest temporal anchor (inclusive), Unix epoch milliseconds.\n\nIf provided, restricts results to notes whose `temporal_index.anchor_ms >= from_ms`.\nApplied as an AND filter after all other filters (ACL, section, locus, status).\nNotes without a `temporal_index` entry are excluded when this bound is set.\n\nAbsent or `null`: no lower bound (unchanged behavior).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "include_corpus_count": {
        "default": false,
        "description": "If `true`, includes in the response the total count of notes matching\nthe **FTS5/BM25 lexical** query within the filtered scope, unbounded by K.\n\nAllows distinguishing \"topic absent from the corpus\" (`corpus_match_count == 0`)\nfrom \"notes present but ranked below K\" (`corpus_match_count > len(results)`).\n\nDoes NOT indicate semantic ANN hit count.\nOpt-in (default `false`): zero overhead when absent — no COUNT is executed.",
        "type": "boolean"
      },
      "include_downgraded": {
        "default": false,
        "description": "If `true`, includes notes with `status = 'downgraded'`\nin the results with a penalized BM25 score (×0.1). Default `false`.",
        "type": "boolean"
      },
      "include_scores": {
        "default": false,
        "description": "If `true`, enriches each result with a `scores` object detailing\nthe composite score breakdown.\n\nOpt-in (default `false`): only consumers that need it pay the payload overhead.\nExisting clients are unaffected — the `scores` field is omitted from the\nresponse when `false`.",
        "type": "boolean"
      },
      "limit": {
        "description": "Maximum number of results (default 10, max 50).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "locus": {
        "description": "locus prefix filter (optional).\n\nE.g. `\"council/\"` → restricts to notes whose `locus` starts with\n`council/`. LIKE metacharacters (`%`, `_`, `\\`) are automatically\nescaped — no SQL injection risk.\n\nAbsent or `null`: no locus filter (unchanged behavior).",
        "type": [
          "string",
          "null"
        ]
      },
      "query": {
        "description": "Full-text or semantic search query.",
        "type": "string"
      },
      "section": {
        "description": "Section filter (optional).",
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "description": "Lifecycle status filter (optional).\n\nAccepted values: the 6 kebab-case `NoteStatus` variants (`draft`, `staging`,\n`pending-review`, `live`, `deprecated`, `garbage`) plus the legacy SQL value\n`downgraded` (tolerated for backward-compatible filtering). Any other value\n→ `400 Bad Request`. Applied at the SQL level (FTS + semantic), consistent\nwith the `section` filter.\n\nAbsent or `null`: no status filter (unchanged behavior).",
        "type": [
          "string",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      },
      "to_ms": {
        "default": null,
        "description": "Latest temporal anchor (inclusive), Unix epoch milliseconds.\n\nIf provided, restricts results to notes whose `temporal_index.anchor_ms <= to_ms`.\nApplied as an AND filter after all other filters (ACL, section, locus, status).\nNotes without a `temporal_index` entry are excluded when this bound is set.\n\nAbsent or `null`: no upper bound (unchanged behavior).\n\nValidation: `from_ms` and `to_ms` may be provided independently; if both are\npresent, `from_ms` must be ≤ `to_ms` (otherwise `400 Bad Request`).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "vault_id": {
        "description": "vault to query in read mode (optional).\n\nLifts the single-tenant constraint **for reads only** — allows querying\na vault other than `tenant_id`. Writes remain unchanged.\nValidation: non-empty, max 128 chars.\n\nAbsent or `null`: uses `tenant_id` (unchanged behavior).",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "query"
    ],
    "title": "VaultSearchRequest",
    "type": "object"
  },
  "vault_status": {
    "properties": {},
    "type": "object"
  },
  "vault_tags": {
    "properties": {},
    "type": "object"
  },
  "vault_timeline": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_timeline` — paginated temporal read.\n\nAll fields are optional except defaults. Server sort order: `anchor_ms DESC,\nnote_id DESC`.\n\n## Validity windowing\n\nThe `(as_of_ms, include_expired)` pair controls temporal filtering:\n\n| `as_of_ms` | `include_expired` | Behavior |\n|---|---|---|\n| absent | `false` (default) | No filter — **baseline behavior** |\n| absent | `true` | No filter (`include_expired` has no effect without reference T) |\n| present | `false` (default) | Strict filter: notes valid at T |\n| present | `true` | Historical filter: notes created before T, including expired |",
    "properties": {
      "as_of_ms": {
        "description": "As-of reference instant for validity filtering (epoch ms UTC).\n\nActivates temporal filtering. Combined with `include_expired`:\n\n- `as_of_ms=t, include_expired=false` (default): **strict filter** — notes valid at T\n  (`anchor_ms ≤ t AND (valid_until IS NULL OR t < valid_until)`).\n- `as_of_ms=t, include_expired=true`: **historical filter** — notes created before T,\n  including expired ones (`anchor_ms ≤ t` only). Useful for reconstructing past state.\n- absent: no validity filter (unchanged baseline behavior).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "cursor": {
        "description": "Opaque pagination cursor (obtained from `next_cursor`).",
        "type": [
          "string",
          "null"
        ]
      },
      "doc_kind": {
        "description": "`doc_kind` filter (`\"Static\"` / `\"Event\"`). Absent = all.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "from_ms": {
        "description": "Lower bound on `anchor_ms`, inclusive (epoch ms).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "include_expired": {
        "default": false,
        "description": "Enables inclusion of expired notes **when `as_of_ms` is present**.\n\nDefault `false`. No effect if `as_of_ms` is absent.\n\n`true` → historical filter: `anchor_ms ≤ t` only (notes expired at T\nare included — useful for reconstructing a past state).",
        "type": "boolean"
      },
      "limit": {
        "description": "Maximum number of rows (default 50, clamped to max 200 server-side).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant (default `\"main\"`).",
        "type": "string"
      },
      "to_ms": {
        "description": "Upper bound on `anchor_ms`, inclusive (epoch ms).",
        "format": "int64",
        "type": [
          "integer",
          "null"
        ]
      },
      "vault_id": {
        "description": "vault to query in read mode (default = `tenant_id`). Max 128 chars.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "title": "VaultTimelineRequest",
    "type": "object"
  },
  "vault_trace": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request body for `vault_trace` — legacy vault v1.6.2 `VaultTraceArgs` parity.",
    "properties": {
      "limit": {
        "description": "Result limit (default 20, max 100).",
        "format": "uint32",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "query": {
        "description": "Trace query (tags, sections, pattern).",
        "type": "string"
      },
      "tenant_id": {
        "default": "main",
        "description": "Tenant identifier (default `\"main\"`).",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "VaultTraceRequest",
    "type": "object"
  },
  "vault_write": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Request body for `vault_write` — creates a note via the async queue.\n\nThe **LIVE queue path** (`SqliteQueueStore`) serializes this struct via `serde_json`.\nThe bincode serialization (`bincode::serde::encode_to_vec`) is used only by the\nlegacy `dispatch.rs` dispatcher and does not apply to the active job pipeline.",
    "properties": {
      "author": {
        "default": null,
        "description": "Author (optional).",
        "type": [
          "string",
          "null"
        ]
      },
      "body": {
        "description": "Markdown body of the note.",
        "type": "string"
      },
      "expected_sha256": {
        "default": null,
        "description": "Expected SHA-256 hash for optimistic locking (optional, hexadecimal).\n\nWhen present, the worker checks that the current hash of the note matches\nbefore writing. On mismatch: terminal job `Conflict` (note not overwritten).\n`None` = unconditional write (backward-compatible).\n\nFormat: 64 lowercase hexadecimal characters (SHA-256 = 32 bytes).\nExample: `\"a3f1c2d4...\"`",
        "type": [
          "string",
          "null"
        ]
      },
      "note_id": {
        "default": null,
        "description": "Pre-allocated ULID — honored by the legacy `SqliteQueue` dispatcher if present\nand parseable as a valid ULID.\n\n`None` = backward-compatible behavior: the dispatcher generates a fresh ULID.\n\n## Bincode field-order invariant\n\nThis field is at **position 8** (last) — AFTER `tenant_id` (pos 6) and\n`expected_sha256` (pos 7). Bincode v2 (`config::standard()`) is positional:\ndeclaration order determines serialization order.\nNever move this field without updating all encoders.",
        "type": [
          "string",
          "null"
        ]
      },
      "occurred_at": {
        "default": null,
        "description": "Temporal anchor — event date of the note (ISO 8601 UTC or YYYY-MM-DD).\n\nWhen present and parseable, the worker sets `anchor_src = occurred_at` and\n`anchor_ms` to this date's epoch milliseconds, instead of the creation time.\n\nAbsent or `null` → `anchor_src = created` (backward-compatible behaviour).\n\n## Accepted formats\n\n- ISO 8601 / RFC 3339 with time: `\"2026-01-15T10:00:00Z\"`\n- Date-only YYYY-MM-DD → start of day UTC: `\"2026-01-15\"`\n\nAn unparseable value is rejected by the server with **400 InvalidInput**.\n\nDates arbitraires (passé/futur) acceptées by-design — pas de borne sémantique.",
        "type": [
          "string",
          "null"
        ]
      },
      "section_hint": {
        "default": null,
        "description": "Suggested section (optional — the curator may override).",
        "type": [
          "string",
          "null"
        ]
      },
      "tags": {
        "default": [],
        "description": "Initial tags (optional — the curator may add more).",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "tenant_id": {
        "default": "main",
        "description": "Target tenant (default `\"main\"`).",
        "type": "string"
      },
      "title": {
        "description": "Title of the note.",
        "type": "string"
      }
    },
    "required": [
      "title",
      "body"
    ],
    "title": "VaultWriteRequest",
    "type": "object"
  }
}
