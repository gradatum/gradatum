  "vault_lessons_recall": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Request for lesson recall.\n\nUsed to generate the `inputSchema` for the `vault_lessons_recall` MCP tool.\nOn the HTTP server side, these fields are received as query params (`?class=&limit=`).",
