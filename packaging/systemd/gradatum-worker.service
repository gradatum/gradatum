[Unit]
Description=Gradatum background worker (curator cascade + job queue)
Documentation=https://gradatum.org
After=network-online.target gradatum-server.service
Wants=network-online.target gradatum-server.service

[Service]
Type=simple
User=gradatum
Group=gradatum
StateDirectory=gradatum
RuntimeDirectory=gradatum
ConfigurationDirectory=gradatum
LogsDirectory=gradatum
ExecStartPre=/usr/local/bin/gradatum-pre-migration-backup
# --db est volontairement absent : le chemin de la queue est dérivé de
# storage.root (GRADATUM_STORAGE__ROOT > [storage] root du --config > défaut) via
# le même helper que gradatum-server. Le passer en dur ne peut que diverger le
# jour où storage.root change — le worker refuserait alors de démarrer.
ExecStart=/usr/bin/gradatum-worker --config /var/lib/gradatum/config/server.toml
# Fichier d'environnement REQUIS — il porte GRADATUM_INTERNAL_TOKEN, jeton de l'API
# interne dont le worker a absolument besoin. Sans lui, le worker échoue au boot sur
# « GRADATUM_INTERNAL_TOKEN must be set » puis boucle Restart=always/15s EN SILENCE
# (le serveur reste up, /health vert). PAS de préfixe `-` : une absence doit échouer
# TÔT et clairement au niveau systemd (« EnvironmentFile not found »), jamais dégénérer
# en crash-loop /health-vert.
#
# scripts/install-gradatum-services.sh écrit ce fichier automatiquement après
# `gradatum-admin init` (jeton lu depuis <root>/config/internal-worker.token.txt).
# Installation MANUELLE — le créer à la main (root:gradatum 0640) avec :
#   # Token de l'API interne (OBLIGATOIRE) — valeur produite par `gradatum-admin init`,
#   # copiée dans <root>/config/internal-worker.token.txt (mode 0600).
#   GRADATUM_INTERNAL_TOKEN=<contenu de internal-worker.token.txt>
#   # URL de l'API interne server (optionnel — défaut http://127.0.0.1:19092).
#   GRADATUM_INTERNAL_URL=http://127.0.0.1:19092
#   # Logs détaillés (optionnel) — sans RUST_LOG, niveau "info" (défaut init_tracing).
#   RUST_LOG=gradatum_worker=info,gradatum_curator=info,gradatum_db_sqlite=debug
EnvironmentFile=/etc/gradatum/env
# Restart=always (vs on-failure) — couvre l'exit 0 "pas leader" : si une lease
# leadership est tenue par un autre worker, l'exit propre est intentionnel mais
# nécessite un retry périodique pour takeover post-expiration. Sans always, le
# service reste inactive après stop+start rapide (lease pas encore expirée).
# RestartSec=15s : lease leadership TTL ~60s, 15s = retry suffisamment fréquent
# sans spinner inutile (4 cycles avant takeover dans le pire cas).
Restart=always
RestartSec=15s
LimitNOFILE=65536
OOMScoreAdjust=-100
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/gradatum /var/log/gradatum
MemoryMax=1G
# Caveat : sans cette ligne, le worker peut etre pousse en swap si la memoire est saturee.
# Sans cette ligne, le worker peut etre pousse en swap si curator+LLM tirent la RAM.
# On prefere un OOM kill propre plutot qu'une degradation silencieuse en swap.
MemorySwapMax=0
CPUWeight=100

[Install]
WantedBy=multi-user.target
